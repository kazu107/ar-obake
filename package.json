{
  "name": "ar-obake-lab",
  "private": true,
  "version": "0.6.2",
  "type": "module",
  "engines": { "node": ">=24.19.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "assets": "node scripts/generate-assets.mjs",
    "compile:targets": "node scripts/compile-targets.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "check:mission": "node scripts/check-mission-balance.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:offline": "node scripts/offline-browser.mjs"
  },
  "dependencies": {
    "mind-ar": "1.2.5",
    "three": "0.160.0"
  },
  "overrides": {
    "mind-ar": { "canvas": "npm:@napi-rs/canvas@1.0.9" },
    "esbuild": "0.28.1"
  },
  "devDependencies": {
    "@msgpack/msgpack": "2.8.0",
    "@napi-rs/canvas": "1.0.9",
    "@types/three": "0.160.0",
    "playwright": "1.58.2",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
